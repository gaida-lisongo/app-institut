# Base de données MongoDB
MONGODB_URI=mongodb://localhost:27017/admin-etab

# JWT Secret (changez cette valeur en production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-with-a-very-long-random-string

# Configuration FlexPay pour les paiements
FLEX_HOST=https://backend.flexpay.cd/api/rest/v1/paymentService
FLEX_CHECK=https://backend.flexpay.cd/api/rest/v1/check/
FLEX_TOKEN=your-flexpay-token-here
FLEX_MERCHANT=your-merchant-id-here

# Durée d'expiration du JWT (optionnel, par défaut 7d)
JWT_EXPIRES_IN=7d

# Environnement
NODE_ENV=development
